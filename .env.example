# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Or Grok
# GROK_API_KEY=...
# OPENAI_BASE_URL=https://api.x.ai/v1

# Default backend is sqlite (set in code). 
# Memory is ephemeral on most free hosts unless you attach a volume.
